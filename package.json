{
  "name": "bet-settlement-service",
  "version": "0.1.0",
  "description": "Exactly-once bet settlement on a double-entry ledger",
  "author": "Artem Soldatov",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test,prisma}/**/*.{ts,json}\"",
    "format:check": "prettier --check \"{src,test,prisma}/**/*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@prisma/client": "^6.5.0",
    "kafkajs": "^2.2.4",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@testcontainers/postgresql": "^10.20.0",
    "@testcontainers/redpanda": "^10.20.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "testcontainers": "^10.20.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
